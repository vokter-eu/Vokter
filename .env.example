# Vokter — environment configuration
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#   nano .env          # or your editor of choice
#   docker compose up -d

# ── Core ─────────────────────────────────────────────────────────────────────
# Strong unique passphrase for local database encryption.
# Generate one with: openssl rand -hex 32
# WARNING: changing this after first run requires re-ingesting all documents.
VOKTER_DB_KEY=change-me-before-first-run

# ── Models ────────────────────────────────────────────────────────────────────
# Pull models before first use:
#   docker exec -it vokter-ollama ollama pull llama3.2:3b
#   docker exec -it vokter-ollama ollama pull nomic-embed-text
VOKTER_CHAT_MODEL=llama3.2:3b
VOKTER_EMBED_MODEL=nomic-embed-text

# ── Email (optional) ──────────────────────────────────────────────────────────
# Leave VOKTER_EMAIL_IMAP_HOST empty to disable the email connector.
# Use an app password, not your real password:
#   Gmail:   myaccount.google.com/apppasswords
#   Outlook: account.microsoft.com/security > App passwords
VOKTER_EMAIL_IMAP_HOST=
VOKTER_EMAIL_IMAP_PORT=993
VOKTER_EMAIL_USER=
VOKTER_EMAIL_PASSWORD=
VOKTER_EMAIL_FOLDER=INBOX
VOKTER_EMAIL_MAX_SYNC=200

# ── Voice ─────────────────────────────────────────────────────────────────────
# Models download automatically on first use.
# Whisper sizes: tiny (fastest) | base | small | medium | large-v3 (most accurate)
VOKTER_WHISPER_MODEL=base
VOKTER_WHISPER_DEVICE=cpu
# Piper voice IDs: https://huggingface.co/rhasspy/piper-voices
VOKTER_PIPER_VOICE=en_US-lessac-medium

# ── Wallet ────────────────────────────────────────────────────────────────────
# Adapter options:
#   cashu       → Cashu e-cash, privacy layer (recommended default)
#   lightning   → Bitcoin Lightning via self-hosted LNbits
#   eurc|eure|eurcv|evm → MiCA stablecoins on EVM chains
#   eurc-solana|eure-solana|sol → Solana tokens
#   monero      → Monero (XMR), untraceable
#   bitcoin     → Bitcoin on-chain
VOKTER_WALLET_ADAPTER=cashu

# Daily spending limit in the adapter's native unit (0 = no limit)
VOKTER_WALLET_SPEND_LIMIT=0

# Cashu — self-hosted mint: github.com/cashubtc/nutshell
VOKTER_CASHU_MINT_URL=

# Lightning (LNbits — never use a cloud LNbits, self-host it)
VOKTER_LNBITS_URL=
VOKTER_LNBITS_INVOICE_KEY=
VOKTER_LNBITS_ADMIN_KEY=

# EVM — works for any EVM chain (Ethereum, Polygon, Base, Gnosis, Avalanche…)
# The chain is determined by the RPC URL, not by VOKTER_EVM_CHAIN (label only).
# Known token contracts: see app/wallet/adapters/evm.py
VOKTER_EVM_RPC_URL=
VOKTER_EVM_PRIVATE_KEY=
VOKTER_EVM_TOKEN_CONTRACT=
VOKTER_EVM_TOKEN_SYMBOL=
VOKTER_EVM_TOKEN_DECIMALS=18
VOKTER_EVM_CHAIN=ethereum

# Solana — native SOL or any SPL token (EURC, EURe…)
# Known mint addresses: see app/wallet/adapters/solana.py
VOKTER_SOLANA_RPC_URL=
VOKTER_SOLANA_PRIVATE_KEY=
VOKTER_SOLANA_TOKEN_MINT=
VOKTER_SOLANA_TOKEN_SYMBOL=

# Monero — requires monero-wallet-rpc running alongside the stack
VOKTER_MONERO_RPC_URL=

# Bitcoin — requires Bitcoin Core RPC or Electrum daemon
VOKTER_BTC_RPC_URL=
VOKTER_BTC_RPC_USER=
VOKTER_BTC_RPC_PASS=

# ── Nostr (Phase 6) ───────────────────────────────────────────────────────────
# Leave empty to disable the Nostr DM listener.
# When set, Vokter listens for private DMs (NIP-17 gift wrap, which hides
# metadata — relays can't see who messages whom) on these relays and
# responds using its local tools (ask, browse, wallet_balance, plan).
# Your Nostr public key (npub) is logged on startup.
# Example: VOKTER_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
VOKTER_NOSTR_RELAYS=

# Comma-separated hex pubkeys allowed to send commands via Nostr DM.
# Leave empty to accept from anyone (only safe on a private relay).
VOKTER_NOSTR_ALLOWED_PUBKEYS=

# ── A2A (Agent2Agent, HTTP) — Phase 6 ─────────────────────────────────────────
# A2A over HTTP is the cross-vendor standard that lets ANY A2A agent talk to
# Vokter. The JSON-RPC endpoint is always served at POST /a2a; these vars only
# control how the agent card advertises it and who is trusted.
#
# VOKTER_A2A_URL: the publicly reachable URL of your /a2a endpoint (e.g. via a
#   tunnel). Leave empty when Vokter is only reachable locally / over Nostr —
#   the card then advertises Nostr (which reaches a local-first Vokter without
#   exposing any port) instead of an unreachable localhost URL.
# Example: VOKTER_A2A_URL=https://your-tunnel.example.com/a2a
VOKTER_A2A_URL=

# Optional bearer token. Unauthenticated HTTP callers can only use the public
# 'introduce' handshake; a caller presenting this token is trusted for the
# private tools (ask, wallet, plan, browse). Leave empty to keep HTTP
# introduce-only. Use a long random value.
VOKTER_A2A_TOKEN=

# ── Admin API token (security) ────────────────────────────────────────────────
# Gates the HUMAN's admin API — everything under /api/ EXCEPT the public agent
# card. A DIFFERENT token from VOKTER_A2A_TOKEN above (that one is for peer
# agents over /a2a; this one is for you). Clients/UI present it as header
#   X-Vokter-Admin-Token: <token>   (or  Authorization: Bearer <token>).
# Empty (default) = unprotected, which is only safe because Vokter is bound to
# 127.0.0.1 and the browser UI is loopback-only. SET THIS, and reverse-proxy
# only /a2a + /.well-known, before exposing Vokter to any network.
VOKTER_ADMIN_TOKEN=
