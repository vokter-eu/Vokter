{
  "name": "vokter-desktop",
  "version": "0.19.0",
  "private": true,
  "description": "Vokter — sovereign local AI agent",
  "author": "Vokter <noreply@vokter.eu>",
  "homepage": "https://github.com/vokter-eu/Vokter",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:csp": "node csp.test.js",
    "probe:csp": "electron --no-sandbox --disable-gpu csp.probe.js",
    "test:a2a": "../runtime/venv/bin/python ../../tests/a2a_trust_boundary_test.py",
    "predist": "npm run test:csp && npm run probe:csp && npm run test:a2a",
    "dist": "electron-builder --linux deb AppImage"
  },
  "build": {
    "appId": "eu.vokter.desktop",
    "productName": "Vokter",
    "electronLanguages": [
      "en-US",
      "es"
    ],
    "files": [
      "main.js",
      "loading.html",
      "loading.js",
      "preload.js",
      "progress_pipe.js",
      "netutil.js",
      "guardrail_screen.js",
      "csp.js",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "../freeze/dist/vokter-backend",
        "to": "desktop/freeze/dist/vokter-backend"
      },
      {
        "from": "../runtime/ollama",
        "to": "desktop/runtime/ollama",
        "filter": [
          "**/*",
          "!lib/ollama/cuda_v12",
          "!lib/ollama/cuda_v12/**",
          "!lib/ollama/cuda_v13",
          "!lib/ollama/cuda_v13/**"
        ]
      },
      {
        "from": "../runtime/tesseract",
        "to": "desktop/runtime/tesseract"
      },
      {
        "from": "../runtime/browser",
        "to": "desktop/runtime/browser"
      },
      {
        "from": "../runtime/pasta",
        "to": "desktop/runtime/pasta"
      },
      {
        "from": "../../NOTICE",
        "to": "NOTICE"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "maintainer": "Vokter <noreply@vokter.eu>",
      "description": "Sovereign local AI agent: bundles the frozen backend and native Ollama (CPU-only). LLM weights and voice models (Kokoro/Piper TTS + whisper STT) download on first run from Vokter's own mirror; GPU acceleration is an optional future add-on."
    },
    "deb": {
      "afterInstall": "build/deb-after-install.sh",
      "afterRemove": "build/deb-after-remove.sh",
      "depends": [
        "bubblewrap",
        "nftables",
        "fonts-liberation",
        "libasound2t64 | libasound2",
        "libatk-bridge2.0-0t64 | libatk-bridge2.0-0",
        "libatk1.0-0t64 | libatk1.0-0",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libcairo2",
        "libcups2t64 | libcups2",
        "libdbus-1-3",
        "libexpat1",
        "libgbm1",
        "libglib2.0-0t64 | libglib2.0-0",
        "libgtk-3-0t64 | libgtk-3-0",
        "libnspr4",
        "libnss3",
        "libpango-1.0-0",
        "libvulkan1",
        "libx11-6",
        "libxcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxkbcommon0",
        "libxrandr2"
      ]
    }
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  }
}
